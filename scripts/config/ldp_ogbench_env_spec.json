{
  "base": "NVIDIA driver 580.65.06 + CUDA 12 JAX plugin + Python 3.10",
  "checkout": "/root/data/yyf/stable-worldmodel-tdmpc2-ogbench8",
  "venv": "/root/data/yyf/stable-worldmodel-tdmpc2-ogbench8/.venv-ldp",
  "system_pkgs": [
    "git",
    "tmux==3.2a"
  ],
  "pip_phases": [
    [
      "pip==24.0",
      "numpy==1.26.4",
      "scipy==1.13.1",
      "h5py==3.11.0",
      "pytest==8.3.5"
    ],
    [
      "jax[cuda12_pip]==0.4.26 from https://storage.googleapis.com/jax-releases/jax_cuda_releases.html"
    ],
    [
      "jax==0.4.26",
      "flax==0.8.4",
      "optax==0.2.2",
      "orbax-checkpoint==0.5.14",
      "diffusers==0.27.2",
      "huggingface-hub==0.23.1",
      "hydra-core==1.2.0",
      "omegaconf==2.3.0"
    ]
  ],
  "env": {
    "XLA_PYTHON_CLIENT_PREALLOCATE": "false",
    "XLA_PYTHON_CLIENT_MEM_FRACTION": "0.18",
    "OMP_NUM_THREADS": "8",
    "MKL_NUM_THREADS": "8",
    "OPENBLAS_NUM_THREADS": "8",
    "MUJOCO_GL": "egl",
    "PYOPENGL_PLATFORM": "egl",
    "OGBENCH_ROOT": "/root/data/yyf/ogbench-eval-main-20260830"
  },
  "upstream": {
    "repository": "https://github.com/amberxie88/latent_diffusion_planning.git",
    "commit": "a26cbf1d2c0aec7adc5d9746f47831b162a41c0c"
  },
  "run_commands": [
    "cd /root/data/yyf/stable-worldmodel-tdmpc2-ogbench8 && MODE=env-witness bash scripts/20260908_yb_ldp_ogbench_cube.sh",
    "cd /root/data/yyf/stable-worldmodel-tdmpc2-ogbench8 && MODE=data-test bash scripts/20260908_yb_ldp_ogbench_cube.sh",
    "cd /root/data/yyf/stable-worldmodel-tdmpc2-ogbench8 && MODE=smoke bash scripts/20260908_yb_ldp_ogbench_cube.sh"
  ],
  "weight_dirs": {},
  "smoke": {
    "import_names": [
      "jax",
      "flax",
      "optax",
      "orbax.checkpoint",
      "diffusers",
      "h5py"
    ],
    "gpu_tests": [
      {
        "cmd": "CUDA_VISIBLE_DEVICES=6 .venv-ldp/bin/python -c 'import jax,jax.numpy as jnp; k=jax.random.PRNGKey(0); x=jax.random.normal(k,(8,8)); y=(x@x).block_until_ready(); print(\"LDP_JAX_WITNESS\",y.shape,jax.devices()[0].device_kind,float(y.sum()))'",
        "expect": "^LDP_JAX_WITNESS \\(8, 8\\) NVIDIA A800-SXM4-80GB"
      }
    ],
    "cli_checks": [
      "nvidia-smi",
      "tmux -V"
    ]
  }
}
